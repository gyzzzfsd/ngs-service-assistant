# 复制本文件为 .env 后按实际环境填写：cp .env.example .env
# .env 已被 .gitignore 排除，切勿把真实口令或 API Key 提交进仓库。
# 只有 DATABASE_URL / LLM_API_KEY / JWT_SECRET 是必填（config.py 里没有默认值），
# 其余项留空即用内置默认值。

# ---------- 应用 ----------
APP_NAME=NGS Service Assistant
APP_PORT=8010
LOG_LEVEL=INFO

# ---------- 数据库（PostgreSQL 16 + pgvector）----------
# 先按 README「快速开始」执行 script/ngs_schema.sql 与 script/seed_ngs.sql
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/ngs_service_assistant

# ---------- 大模型（OpenAI 兼容协议）----------
LLM_PROVIDER=zhipu
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=<your-api-key>
LLM_MODEL=glm-4.5-air

# ---------- Embedding（bge-m3，1024 维）----------
# 本地模型目录；留空则由 FlagEmbedding 从 HuggingFace 拉取
EMBEDDING_BACKEND=local
EMBEDDING_MODEL_PATH=
# 无 GPU 时改成 cpu
EMBEDDING_DEVICE=cuda

# ---------- 知识库 ----------
# 相对项目根，语料放在 document/docs/*.md
KNOWLEDGE_DIR=./document

# ---------- 认证 ----------
JWT_SECRET=<replace-with-a-random-string>

# ---------- 前端 ----------
# 用 python -m http.server 8080 --directory web 时放开 8080 来源
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:8080
